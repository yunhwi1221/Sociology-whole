# Supabase — 공개용(publishable) 키만 사용한다.
# secret / service_role 키는 브라우저에 노출되므로 절대 여기에 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# (구버전 호환) legacy anon key를 쓰는 경우에만 필요
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API (AI 질답용, /api/ai-chat.js) — 서버에서만 사용. NEXT_PUBLIC_ 접두사 금지.
# https://aistudio.google.com/apikey 에서 무료로 발급 가능.
GEMINI_API_KEY=your_gemini_api_key
